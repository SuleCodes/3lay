# Copy to .env.local

# All frontend config lives in Azure App Configuration under keys prefixed
# "FRONTEND:" (e.g. FRONTEND:NEXT_PUBLIC_API_URL). This connection string is
# the only thing that needs setting -- here locally, and in the environment of
# whatever builds/hosts the deployed frontend.
APP_CONFIG_CONNECTION_STRING=

# Optional local overrides: a value set here wins over App Configuration
# (FRONTEND:*) on this machine only. Deployed builds have no .env.local, so they
# use App Configuration. Typical use -- keep your local dev server on your
# local backend while App Configuration holds the deployed API URL:
NEXT_PUBLIC_API_URL=http://localhost:8000
# Restart `npm run dev` after changing it; NEXT_PUBLIC_* values are read at
# startup/build.
