# Copy to .env.local

# All frontend config lives in Azure App Configuration under keys prefixed
# "FRONTEND:" (e.g. FRONTEND:NEXT_PUBLIC_API_URL). This connection string is
# the only thing that needs setting -- here locally, and in the environment of
# whatever builds/hosts the deployed frontend.
APP_CONFIG_CONNECTION_STRING=

# Without a connection string, NEXT_PUBLIC_API_URL falls back to
# http://localhost:8000 (see src/lib/api.ts).
