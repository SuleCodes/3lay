# Copy this file to .env.

# All backend config and secrets live in Azure App Configuration under keys
# prefixed "BACKEND:" (BACKEND:DATABASE_URL, BACKEND:JWT_SECRET, ...). This
# connection string is the only thing that needs setting -- locally here, and
# as an app setting / env var on the deployed instance.
APP_CONFIG_CONNECTION_STRING=

# ---------------------------------------------------------------------------
# Optional local overrides. Normally leave these out: App Configuration takes
# priority over this file, so a value here is only used for a key App
# Configuration doesn't define. To override a value for one run, set it as a
# real environment variable instead (those beat App Configuration).
#
# Settings the backend reads (without the BACKEND: prefix):
#   DATABASE_URL               Postgres connection string -- required. For
#                              Supabase, the "Session pooler" string, as-is.
#   JWT_SECRET                 Signs session cookies.
#   JWT_EXPIRE_MINUTES         Session length (default 43200 = 30 days).
#   MAGIC_LINK_EXPIRE_MINUTES  Sign-in link lifetime (default 15).
#   FRONTEND_URL               Next.js origin, for links and CORS.
#   SESSION_COOKIE_NAME        Default 3lay_session.
#   RESEND_API_KEY             Optional. Blank = magic links are printed to
#                              the backend console instead of emailed.
#   EMAIL_FROM                 Sender for magic-link emails.
# ---------------------------------------------------------------------------
